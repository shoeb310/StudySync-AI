# ==============================================================================
# StudySync AI - Backend Environment Variables
# ==============================================================================

PROJECT_NAME="StudySync AI Backend"
ENVIRONMENT=development
PORT=8000

# Google Gemini API Key (Required for text-embedding-004 and gemini-1.5-flash)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB Vector Database Connection
# When running via Docker Compose: studysync_chroma
# When running locally outside Docker: localhost
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=studysync_documents

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
